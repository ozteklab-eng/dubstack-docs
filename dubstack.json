{
  "$schema": "https://dubstack.ai/dubstack.json",
  "site": {
    "name": "dubstack docs",
    "tagline": "Build, publish, and scale developer documentation with DubStack.",
    "logo": {
      "light": "/logo/light.svg",
      "dark": "/logo/dark.svg"
    },
    "favicon": "/img/favicon.ico",
    "timezone": "UTC"
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "interactive"
    }
  },
  "theme": "prism",
  "palette": "classic",
  "styling": {
    "codeblocks": "system"
  },
  "colors": {
    "primary": "#15803D",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "addons": {
    "feedback": {
      "thumbs_rating": true,
      "edit_suggestions": false,
      "raise_issues": false,
      "contextual_feedback": false,
      "code_snippet_feedback": false,
      "agent_feedback": true,
      "collect_reader_emails": false,
      "reader_email_disclaimer": ""
    }
  },
  "redirects": [
    {
      "source": "/agent",
      "destination": "/ai/agent"
    },
    {
      "source": "/assistant",
      "destination": "/ai/assistant"
    },
    {
      "source": "/workflows",
      "destination": "/automations"
    },
    {
      "source": "/workflow",
      "destination": "/automations"
    },
    {
      "source": "/integrations",
      "destination": "/ai/integrations"
    }
  ],
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://dubstack.ai/#register"
    }
  },
  "contextual": {
    "enabled": true,
    "options": [
      "copy",
      "view",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "claude",
      "chatgpt",
      "perplexity"
    ],
    "default": "copy",
    "labels": {
      "copy": "Copy page",
      "view": "View as Markdown",
      "mcp": "Copy MCP server URL",
      "add-mcp": "Copy MCP install command",
      "cursor": "Connect to Cursor",
      "vscode": "Connect to VS Code",
      "claude": "Ask Claude",
      "chatgpt": "Ask ChatGPT",
      "perplexity": "Ask Perplexity"
    }
  },
  "widgets": {
    "search": {
      "enabled": true,
      "placeholder": "Search docs..."
    },
    "assistant": {
      "title": "Assistant",
      "welcome_title": "How can I help with DubStack?",
      "welcome_subtitle": "Ask about configuration, publishing, migration, and docs workflows.",
      "user_bubble_color": "color-mix(in srgb, var(--assistant-bg) 86%, var(--foreground) 14%)",
      "user_bubble_text_color": "var(--assistant-text)",
      "source_card_background_color": "color-mix(in srgb, var(--assistant-bg) 94%, var(--foreground) 6%)",
      "source_card_border_color": "color-mix(in srgb, var(--assistant-border) 70%, transparent)",
      "source_card_text_color": "var(--assistant-text)",
      "source_card_muted_color": "var(--docs-muted-text, var(--gray-400))"
    }
  },
